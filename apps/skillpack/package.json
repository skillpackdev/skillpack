{
  "name": "@skillpack/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "expose": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm db:migrate:remote && wrangler deploy",
    "env:pull": "doppler secrets download --no-file --format env > .dev.vars",
    "typecheck": "tsc --noEmit --project tsconfig.client.json --pretty false && tsc --noEmit --project tsconfig.server.json --pretty false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply skillpack --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "node scripts/seed-local.mjs",
    "oauth:test:local": "node scripts/test-oauth-local.mjs",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth/oauth-provider": "^1.6.11",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@hono/mcp": "^0.3.0",
    "@hono/zod-validator": "^0.7.0",
    "@hookform/resolvers": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@skillpack/contracts": "workspace:*",
    "@skillpack/core": "workspace:*",
    "@tailwindcss/vite": "^4.1.7",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/router-plugin": "^1.168.11",
    "@tanstack/zod-adapter": "^1.167.0",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "catalog:",
    "dompurify": "^3.4.5",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.7.10",
    "hono-rate-limiter": "^0.5.3",
    "ky": "^2.0.2",
    "lucide-react": "^0.511.0",
    "next-themes": "^0.4.6",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "p-map": "^7.0.5",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.76.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.8.0",
    "shiki": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.7",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.28",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.4",
    "@cloudflare/workers-types": "^4.20250521.0",
    "@skillpack/typescript-config": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "drizzle-kit": "^0.31.1",
    "miniflare": "^4.20260521.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7",
    "wrangler": "^4.16.1"
  },
  "cloudflare": {
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "Generate a random auth secret, for example with `openssl rand -hex 32`."
      },
      "BUCKET": {
        "description": "R2 bucket used for content-addressed skill resources."
      },
      "DB": {
        "description": "D1 database used for Skillpack metadata, auth state, and skill versions."
      },
      "GITHUB_CLIENT_ID": {
        "description": "Create a GitHub OAuth App and use its Client ID. Callback path: `/api/auth/callback/github`."
      },
      "GITHUB_CLIENT_SECRET": {
        "description": "Use the Client Secret from the same GitHub OAuth App."
      }
    }
  }
}

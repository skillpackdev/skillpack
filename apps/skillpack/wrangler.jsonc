{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skillpack",
  "main": "server/worker.ts",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*", "/mcp"],
  },
  "vars": {
    "GITHUB_CLIENT_ID": "replace-with-github-oauth-app-client-id",

    // Optional auth values:
    // "AUTH_BASE_URL": "http://localhost:5173",
    // "OIDC_CLIENT_ID": "replace-with-oidc-client-id",
    // "OIDC_DISCOVERY_URL": "https://issuer.example.com/.well-known/openid-configuration",
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GITHUB_CLIENT_SECRET",
      "OIDC_CLIENT_ID",
      "OIDC_DISCOVERY_URL",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skillpack",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "skillpack-objects",
    },
  ],
}
